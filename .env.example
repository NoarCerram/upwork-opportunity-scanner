# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Path to your Chrome user data directory (needed by collector.py for Playwright).
# The folder must contain a "Default" profile that is already logged into Upwork.
# Chrome must be fully CLOSED before running collector.py.
#
# Windows:  C:\Users\YourName\AppData\Local\Google\Chrome\User Data
# macOS:    /Users/yourname/Library/Application Support/Google/Chrome
# Linux:    /home/yourname/.config/google-chrome
CHROME_PROFILE_PATH=/home/yourname/.config/google-chrome
