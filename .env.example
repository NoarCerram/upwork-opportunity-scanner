# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Claude API (required for collector_claude.py) ─────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Upwork session cookies (optional but recommended) ─────────────────────────
# Gives collector_claude.py access to authenticated search results.
# How to get: log into upwork.com in Chrome → F12 → Application → Cookies →
# copy values for: oauth2_global_js_token, visitor_id, master_access_token
# Paste them here as a semicolon-separated cookie string.
UPWORK_COOKIES=oauth2_global_js_token=xxx; visitor_id=yyy; master_access_token=zzz

# ── Playwright collector (legacy — requires Chrome to be closed) ───────────────
# Only needed if using collector.py (Playwright-based). collector_claude.py does NOT need this.
# Windows:  C:\Users\YourName\AppData\Local\Google\Chrome\User Data
# macOS:    /Users/yourname/Library/Application Support/Google/Chrome
# Linux:    /home/yourname/.config/google-chrome
CHROME_PROFILE_PATH=/home/yourname/.config/google-chrome
